# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Postgres Connection String for Supabase or direct postgres connection
SUPABASE_DB_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Or configure individual DB variables:
# SQL_HOST="localhost"
# SQL_USER="postgres"
# SQL_PASSWORD="password"
# SQL_DB_NAME="kerukunan"

# JWT Secret for authentication
JWT_SECRET="super-secret-key-change-in-production"
